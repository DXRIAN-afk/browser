{
  "name": "browser",
  "version": "0.2.0",
  "description": "SchoolWeb – Browser auf Chromium-Basis mit Konten, Favoriten und Admin-Bereich",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "node scripts/write-server.js && electron-builder --win zip --x64",
    "build:ftp": "npm run dist:win && node scripts/build-ftp.js"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "resedit": "^2.0.3"
  },
  "author": "Darian",
  "build": {
    "appId": "ch.da-rtx.schoolweb",
    "productName": "SchoolWeb",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "artifactName": "SchoolWeb-${version}-Windows.${ext}",
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "compression": "maximum",
    "copyright": "© 2026 Darian",
    "afterPack": "scripts/after-pack.js"
  }
}
